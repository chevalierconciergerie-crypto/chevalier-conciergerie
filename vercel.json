{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "trailingSlash": false,
  "redirects": [
    { "source": "/(.*)\\.html", "destination": "/$1", "permanent": true },
    { "source": "/tarifs", "destination": "/conciergerie", "permanent": true },
    { "source": "/en/tarifs", "destination": "/en/conciergerie", "permanent": true },
    { "source": "/partenaires", "destination": "/a-propos", "permanent": true },
    { "source": "/en/partenaires", "destination": "/en/a-propos", "permanent": true },
    { "source": "/blog/combien-coute-une-conciergerie-airbnb-a-avignon", "destination": "/blog/tarif-conciergerie-airbnb", "permanent": true },
    { "source": "/journal/combien-coute-une-conciergerie-airbnb-a-avignon", "destination": "/blog/tarif-conciergerie-airbnb", "permanent": true },
    { "source": "/journal", "destination": "/blog", "permanent": true },
    { "source": "/journal/:slug([a-z0-9-]+)", "destination": "/blog/:slug", "permanent": true },
    { "source": "/en/blog", "destination": "/blog", "permanent": false },
    { "source": "/en/blog/:slug", "destination": "/blog/:slug", "permanent": false },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.chevalier-conciergerie.com" }],
      "destination": "https://chevalier-conciergerie.com/:path*",
      "permanent": true
    }
  ]
}
